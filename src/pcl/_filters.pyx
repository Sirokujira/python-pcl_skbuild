    def set_mean_k(self, int k):
        """Number of neighbours to average over."""
        self.me.setMeanK(k)

    def set_std_dev_mul_thresh(self, double std_mul):
        """Distance threshold, in standard deviations."""
        self.me.setStddevMulThresh(std_mul)

