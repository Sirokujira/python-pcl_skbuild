cdef class PassThroughFilter:
    """Keep points whose field value falls inside a range
    (pcl::PassThrough)."""

    cdef cPassThrough[PointXYZ]* me

    def __cinit__(self, PointCloud pc=None):
        self.me = new cPassThrough[PointXYZ]()
        if pc is not None:
            self.set_InputCloud(pc)

    def __dealloc__(self):
        del self.me
        self.me = NULL

    def set_InputCloud(self, PointCloud pc not None):
        self.me.setInputCloud(pc.thisptr_shared)

    def set_filter_field_name(self, field_name):
        """Field to filter on, e.g. ``"z"``."""
        self.me.setFilterFieldName(_tobytes(field_name))

    def get_filter_field_name(self):
        return self.me.getFilterFieldName().decode()

    def set_filter_limits(self, float filter_min, float filter_max):
        self.me.setFilterLimits(filter_min, filter_max)

    def set_negative(self, bint negative):
        """Invert the selection: keep what would otherwise be removed."""
        self.me.setNegative(negative)

    def get_negative(self):
        return self.me.getNegative()

    def set_keep_organized(self, bint keep_organized):
        self.me.setKeepOrganized(keep_organized)

    def filter(self):
        cdef PointCloud pc = PointCloud()
        cdef cPointCloud[PointXYZ]* out = pc.ptr()
        with nogil:
            self.me.filter(deref(out))
        return pc


